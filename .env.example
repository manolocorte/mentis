# --- Mentis backend configuration (local dev / Lambda) ---
APP_ENV=dev
AWS_REGION_NAME=us-east-1

# DynamoDB single table
TABLE_NAME=mentis-dev

# S3
DOCUMENTS_BUCKET=mentis-dev-documents

# S3 Vectors
VECTOR_BUCKET=mentis-dev-vectors
VECTOR_INDEX_CHUNKS=chunks
VECTOR_INDEX_MEMORY=memory

# SQS (leave empty locally to use the no-op queue)
INGEST_QUEUE_URL=

# Bedrock models (tiered for cost)
BEDROCK_REGION=us-east-1
BEDROCK_ROUTER_MODEL=anthropic.claude-haiku-4-5-20251001
BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-4-6
BEDROCK_DRAFT_MODEL=anthropic.claude-opus-4-8
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024

# Auth (or set API_KEY_SSM=/mentis/dev/api_key in Lambda)
API_KEY=

# Scraper
UNPAYWALL_EMAIL=

# University source — leave empty for now; set later to enable Scopus
UNIVERSITY_API_KEY=
UNIVERSITY_BASE_URL=

# Agentic guardrails
MAX_REFLEXION_ITERATIONS=2
RETRIEVE_TOP_K=8
