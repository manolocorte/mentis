# Mentis-lean backend config (copy to .env; .env is gitignored)

# AWS / Bedrock — needs valid creds (aws configure / SSO) with Bedrock access
AWS_REGION=eu-south-2

# Bedrock model IDs (EU inference profiles). CONFIRM exact IDs in the console:
#   aws bedrock list-inference-profiles --region eu-south-2
# MODEL_SUPERVISOR=eu.amazon.nova-pro-v1:0
# MODEL_WORKER=eu.amazon.nova-lite-v1:0
# MODEL_DRAFT=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# MODEL_VERIFY=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Research tools
CONTACT_EMAIL=manolo.corte@mscope.tech   # OpenAlex/Unpaywall polite pool
# SCOPUS_API_KEY=your-elsevier-key        # leave unset to disable Scopus

# App
# API_KEY=set-a-shared-secret             # leave unset for open local dev
ALLOWED_ORIGINS=http://localhost:3000
